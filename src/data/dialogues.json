              "skillMin": {
                "id": "basic_training",
                "level": 9
              },
              "hasItem": {
                "id": "sweet_apple",
                "count": 4
              }
            },
            "next": "ready"
          },
          {
            "if": {
              "jobLevelMin": 10,
              "skillMin": {
                "id": "basic_training",
                "level": 9
              }
            },
            "next": "fee"
          }
        ],
        "else": "not_ready"
      },
