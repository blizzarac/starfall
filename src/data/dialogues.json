[
  {
    "id": "waystone",
    "nodes": {
      "start": {
        "text": "Welcome, {name}. The waystone remembers travellers who rest beside it.",
        "choices": [
          {
            "label": "Make this my return point",
            "do": [
              {
                "type": "setSavePoint"
              }
            ],
            "next": "saved"
          },
          {
            "label": "Rest a while (free)",
            "do": [
              {
                "type": "heal"
              }
            ],
            "next": "rested"
          },
          {
            "label": "Goodbye"
          }
        ]
      },
      "saved": {
        "text": "Done. If you faint or use a Butterfly Wing, you'll wake up right here."
      },
      "rested": {
        "text": "You feel refreshed. HP and SP fully restored."
      }
    }
  },
  {
    "id": "tool_dealer",
    "nodes": {
      "start": {
        "text": "Tonics, wings and fresh apples! Got loot to sell? I'll pay half what it's worth, which is more than the monsters will.",
        "choices": [
          {
            "label": "Let's trade",
            "do": [
              {
                "type": "openShop",
                "shop": "tool_dealer"
              }
            ]
          },
          {
            "label": "What do wings do?",
            "next": "wings"
          },
          {
            "label": "Goodbye"
          }
        ]
      },
      "wings": {
        "text": "A Fly Wing whisks you to a random spot on the same map. A Butterfly Wing takes you straight home to your return point. Green Herbs cure poison, and a Panacea cures anything.",
        "choices": [
          {
            "label": "Let's trade",
            "do": [
              {
                "type": "openShop",
                "shop": "tool_dealer"
              }
            ]
          },
          {
            "label": "Thanks"
          }
        ]
      }
    }
  },
  {
    "id": "guide",
    "nodes": {
      "start": {
        "text": "New in Brightmoor? I'm Pell. Ask me anything.",
        "choices": [
          {
            "label": "How do I fight?",
            "next": "fight"
          },
          {
            "label": "Where should I go?",
            "next": "where"
          },
          {
            "label": "How do I get stronger?",
            "next": "stronger"
          },
          {
            "label": "Goodbye"
          }
        ]
      },
      "fight": {
        "text": "Tap a monster and you'll walk up and keep attacking. Sit to recover faster, and keep a few Red Tonics on hand.",
        "choices": [
          {
            "label": "Anything else?",
            "next": "start"
          },
          {
            "label": "Thanks"
          }
        ]
      },
      "where": {
        "text": "Take the road south to the Southern Meadow. The Jellops there are harmless unless you poke them.",
        "choices": [
          {
            "label": "Anything else?",
            "next": "start"
          },
          {
            "label": "Thanks"
          }
        ]
      },
      "stronger": {
        "text": "Every level gives stat points: open Stats to spend them. At job level 10 you can join a guild: Swordsmen (Captain Harlan), Mages (Magister Ilse), Archers (Wren) or Acolytes (Sister Maren). Sell loot to Bram so your bag never gets too heavy.",
        "choices": [
          {
            "label": "Anything else?",
            "next": "start"
          },
          {
            "label": "Thanks"
          }
        ]
      }
    }
  },
  {
    "id": "swordsman_guild",
    "nodes": {
      "start": {
        "text": "Swordsman Guild. You look like you could swing a blade, {name}.",
        "choices": [
          {
            "label": "I want to become a Swordsman",
            "next": "check",
            "if": {
              "job": "novice"
            }
          },
          {
            "label": "What does a Swordsman do?",
            "next": "about"
          },
          {
            "label": "Goodbye"
          }
        ]
      },
      "check": {
        "branch": [
          {
            "if": {
              "jobLevelMin": 10,
              "skillMin": {
                "id": "basic_training",
                "level": 9
              },
              "hasItem": {
                "id": "jelly_drop",
                "count": 10
              }
            },
            "next": "ready"
          },
          {
            "if": {
              "jobLevelMin": 10,
              "skillMin": {
                "id": "basic_training",
                "level": 9
              }
            },
            "next": "fee"
          }
        ],
        "else": "not_ready"
      },
      "not_ready": {
        "text": "Not yet. Reach job level 10 and put all 9 of your skill points into Basic Training. Open Skills to spend them.",
        "choices": [
          {
            "label": "I'll be back"
          }
        ]
      },
      "fee": {
        "text": "You've trained well. Your trial: bring me 10 Jelly Drops from the Southern Meadow. A Swordsman finishes what they start.",
        "choices": [
          {
            "label": "On my way"
          }
        ]
      },
      "ready": {
        "text": "10 Jelly Drops, and the scars to prove it. Hand them over and swear the Swordsman's oath?",
        "choices": [
          {
            "label": "I swear it",
            "do": [
              {
                "type": "takeItem",
                "id": "jelly_drop",
                "count": 10
              },
              {
                "type": "changeJob",
                "job": "swordsman"
              }
            ],
            "next": "welcome"
          },
          {
            "label": "Not yet"
          }
        ]
      },
      "welcome": {
        "text": "Welcome to the Guild, Swordsman {name}! You keep your unspent skill points. Open Skills and learn Bash first."
      },
      "about": {
        "text": "Swordsmen take hits and hit back harder. You'll learn Bash for heavy single blows, Magnum Break to blast a crowd, and Endure to shrug off damage.",
        "choices": [
          {
            "label": "Tell me how to join",
            "next": "check",
            "if": {
              "job": "novice"
            }
          },
          {
            "label": "Thanks"
          }
        ]
      }
    }
  },
  {
    "id": "blacksmith",
    "nodes": {
      "start": {
        "text": "Greta's forge. Blades, shields, boots: if it keeps you alive out there, I make it.",
        "choices": [
          {
            "label": "Show me your gear",
            "do": [
              {
                "type": "openShop",
                "shop": "blacksmith"
              }
            ]
          },
          {
            "label": "Refine my gear",
            "next": "refine_info"
          },
          {
            "label": "How do I wear gear?",
            "next": "howto"
          },
          {
            "label": "Goodbye"
          }
        ]
      },
      "howto": {
        "text": "Open Items and tap Equip next to a piece of gear. The Gear tab shows what you're wearing. Some pieces are for Swordsmen only, and some need a higher level.",
        "choices": [
          {
            "label": "Show me your gear",
            "do": [
              {
                "type": "openShop",
                "shop": "blacksmith"
              }
            ]
          },
          {
            "label": "Thanks"
          }
        ]
      },
      "refine_info": {
        "text": "Each attempt costs one Brightstone and some gold. Up to +4 I never fail. Past that, the metal can shatter and the piece is gone, cards and all. I'll show you the odds first.",
        "choices": [
          {
            "label": "Let's refine",
            "do": [
              {
                "type": "openRefine"
              }
            ]
          },
          {
            "label": "Maybe later"
          }
        ]
      }
    }
  },
  {
    "id": "mage_guild",
    "nodes": {
      "start": {
        "text": "The Circle of Mages. Magic is patience, {name}, and a good deal of standing still.",
        "choices": [
          {
            "label": "I want to become a Mage",
            "next": "check",
            "if": {
              "job": "novice"
            }
          },
          {
            "label": "What does a Mage do?",
            "next": "about"
          },
          {
            "label": "Goodbye"
          }
        ]
      },
      "check": {
        "branch": [
          {
            "if": {
              "jobLevelMin": 10,
              "skillMin": {
                "id": "basic_training",
                "level": 9
              },
              "hasItem": {
                "id": "beetle_shell",
                "count": 5
              }
            },
            "next": "ready"
          },
          {
            "if": {
              "jobLevelMin": 10,
              "skillMin": {
                "id": "basic_training",
                "level": 9
              }
            },
            "next": "fee"
          }
        ],
        "else": "not_ready"
      },
      "not_ready": {
        "text": "Not yet. Reach job level 10 and put all 9 of your skill points into Basic Training.",
        "choices": [
          {
            "label": "I'll be back"
          }
        ]
      },
      "fee": {
        "text": "Your trial: bring me 5 Beetle Shells from Thornfield, east of the Southern Meadow. Their shells focus mana. Mind the beetles: they bite first.",
        "choices": [
          {
            "label": "On my way"
          }
        ]
      },
      "ready": {
        "text": "Five shells, still warm. Hand them over and take the Circle's vow?",
        "choices": [
          {
            "label": "I vow it",
            "do": [
              {
                "type": "takeItem",
                "id": "beetle_shell",
                "count": 5
              },
              {
                "type": "changeJob",
                "job": "mage"
              }
            ],
            "next": "welcome"
          },
          {
            "label": "Not yet"
          }
        ]
      },
      "welcome": {
        "text": "Welcome to the Circle, Mage {name}! Learn a bolt in Skills. Casting takes time and a hit will break your focus, so strike from afar. Greta sells staves."
      },
      "about": {
        "text": "Mages hurl Fire, Cold and Lightning Bolts from nine tiles away and pick the element a monster is weak to. Soul Strike hits anything. Raise INT for power and DEX to cast faster.",
        "choices": [
          {
            "label": "Tell me how to join",
            "next": "check",
            "if": {
              "job": "novice"
            }
          },
          {
            "label": "Thanks"
          }
        ]
      }
    }
  },
  {
    "id": "hunting_board",
    "nodes": {
      "start": {
        "text": "BRIGHTMOOR HUNTING BOARD. Bounties posted by the town. Take up to three at a time and come back here to collect.",
        "choices": [
          {
            "label": "Read the bounties",
            "do": [
              {
                "type": "openQuests"
              }
            ]
          },
          {
            "label": "Leave"
          }
        ]
      }
    }
  },
  {
    "id": "archer_guild",
