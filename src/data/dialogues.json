  {
    "id": "acolyte_chapel",
    "nodes": {
      "start": {
        "text": "Welcome to the chapel, {name}. Everyone who walks in is tired. Sit a while.",
        "choices": [
          {
            "label": "I want to become an Acolyte",
            "next": "check",
            "if": {
              "job": "novice"
            }
          },
          {
            "label": "What does an Acolyte do?",
            "next": "about"
          },
          {
            "label": "Goodbye"
          }
        ]
      },
      "check": {
        "branch": [
